	src/persistent-data/dm-array.o src/persistent-data/dm-bitset.o \
	src/persistent-data/dm-block-manager.o \
	src/persistent-data/dm-space-map-common.o \
	src/persistent-data/dm-space-map-disk.o \
	src/persistent-data/dm-space-map-metadata.o \
	src/persistent-data/dm-transaction-manager.o \
	src/persistent-data/dm-btree.o src/persistent-data/dm-btree-remove.o \
	src/persistent-data/dm-btree-spine.o src/dm-thin-metadata.o src/dm-thin.o
ccflags-y += -I$(srctree)/drivers/md -I$(src)/src -I$(src)/src/persistent-data
ccflags-y += -I$(THINPOOL_INCLUDE_DIR) -include $(src)/private-rename.h
