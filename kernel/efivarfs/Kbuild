obj-m := efivarfs.o

# The frontend is pinned ACK source per kernel generation. The 6.12 import is
# the module root. The 6.1 and 6.18 imports are separate pins under ack/.
# Select on the target kernel version, not on the KMI generation: the kernel
# version names the VFS and EFI interfaces, the KMI generation names the
# published ABI. Do not translate one generation's frontend for another.
EFIVARFS_KERNEL := $(VERSION).$(PATCHLEVEL)

ifeq ($(EFIVARFS_KERNEL),6.1)
EFIVARFS_DIR := ack/android14-6.1
else ifeq ($(EFIVARFS_KERNEL),6.12)
EFIVARFS_DIR :=
else ifeq ($(EFIVARFS_KERNEL),6.18)
EFIVARFS_DIR := ack/android17-6.18
else
$(error efivarfs: no pinned ACK frontend for kernel $(EFIVARFS_KERNEL); supported kernels: 6.1 6.12 6.18)
endif

# The 6.12 pin predates upstream 4b22ec1685ce ("efivarfs: fix error propagation
# in efivar_entry_get()"). The 6.1 and 6.18 pins already contain that fix.
EFIVARFS_AUDIT_PATCH := $(if $(filter 6.12,$(EFIVARFS_KERNEL)),$(src)/patches/0002-efivarfs-return-get-status.patch)

EFIVARFS_PATH = $(if $(EFIVARFS_DIR),$(EFIVARFS_DIR)/)
efivarfs-y := $(EFIVARFS_PATH)super.o $(EFIVARFS_PATH)inode.o \
	$(EFIVARFS_PATH)file.o $(EFIVARFS_PATH)vars-patched.o metadata.o
ccflags-y += -Werror -I$(src)/$(EFIVARFS_DIR) -I$(src)/../../include

# The 6.18 super.c keeps upstream's "#include \"../internal.h\"". In the kernel
# tree that resolves from fs/efivarfs to fs/internal.h, which declares
# find_next_child(). Give only that object the same base directory, so the
# pinned include resolves against the target kernel source. No copied header.
ifeq ($(EFIVARFS_KERNEL),6.18)
CFLAGS_$(EFIVARFS_PATH)super.o += -I$(srctree)/fs/efivarfs
endif

targets += $(EFIVARFS_PATH)vars-guid.c $(EFIVARFS_PATH)vars-patched.c
clean-files += $(EFIVARFS_PATH)vars-guid.c $(EFIVARFS_PATH)vars-patched.c

# Step 1: pinned vars.c plus the project GUID patch.
quiet_cmd_maos_guid = PATCH   $@
      cmd_maos_guid = mkdir -p $(@D) && patch --silent --fuzz=0 --output=$@ $< < $(src)/patches/0001-maos-project-guid.patch
$(obj)/$(EFIVARFS_PATH)vars-guid.c: $(src)/$(EFIVARFS_PATH)vars.c $(src)/patches/0001-maos-project-guid.patch FORCE
	$(call if_changed,maos_guid)

# Step 2: audited upstream fix on top, or an unmodified copy when the pin has it.
ifeq ($(EFIVARFS_AUDIT_PATCH),)
quiet_cmd_maos_audit = COPY    $@
      cmd_maos_audit = cp $< $@
else
quiet_cmd_maos_audit = PATCH   $@
      cmd_maos_audit = patch --silent --fuzz=0 --output=$@ $< < $(EFIVARFS_AUDIT_PATCH)
endif
$(obj)/$(EFIVARFS_PATH)vars-patched.c: $(obj)/$(EFIVARFS_PATH)vars-guid.c $(EFIVARFS_AUDIT_PATCH) FORCE
	$(call if_changed,maos_audit)
