obj-m := efivarfs.o
efivarfs-y := super.o inode.o file.o vars-patched.o metadata.o
ccflags-y += -Werror -I$(src)/../../include
targets += vars-patched.c
clean-files += vars-patched.c
quiet_cmd_esu_vars = PATCH   $@
      cmd_esu_vars = patch --silent --fuzz=0 --output=$@ $< < $(src)/patches/0001-esu-project-guid.patch
$(obj)/vars-patched.c: $(src)/vars.c $(src)/patches/0001-esu-project-guid.patch FORCE
	$(call if_changed,esu_vars)
